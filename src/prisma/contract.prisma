
// use prisma-next

enum EventStatus {
  DRAFT
  PLANNING
  PRE_PRODUCTION
  READY
  LIVE
  COMPLETED
  ARCHIVED
  ON_HOLD
  CANCELLED
}

enum UserRole {
  OWNER
  ADMIN
  PRODUCER
  PRODUCTION_MANAGER
  DEPARTMENT_HEAD
  CREW
  VIEWER
}

enum DepartmentType {
  AUDIO
  LIGHTING
  VIDEO
  STAGE
  POWER
  RIGGING
  STREAMING
  SPECIAL_EFFECTS
  SECURITY
  TRANSPORT
  OTHER
}

enum CrewStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum CrewType {
  EMPLOYEE
  FREELANCER
  CONTRACTOR
  INTERN
}

enum AssignmentStatus {
  PLANNED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  RESERVED
  MAINTENANCE
  DAMAGED
  LOST
  RETIRED
}

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  NON_FUNCTIONAL
}

enum EquipmentOwnership {
  OWNED
  RENTED
  LEASED
  CLIENT_PROVIDED
  VENDOR_PROVIDED
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  users               User[]
  clients             Client[]
  venues              Venue[]
  events              Event[]
  crewMembers         CrewMember[]
  equipmentCategories EquipmentCategory[]
  equipment            Equipment[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?  @unique
  name      String?
  role      UserRole @default(CREW)

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int

  createdEvents Event[] @relation("EventCreatedBy")

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Client {
  id      Int     @id @default(autoincrement())
  name    String
  company String?
  email   String?
  phone   String?
  notes   String?

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int

  events Event[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Venue {
  id       Int     @id @default(autoincrement())
  name     String
  address  String?
  city     String?
  capacity Int?
  notes    String?

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int

  events Event[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Event {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  status      EventStatus @default(DRAFT)

  startDate TimestamptzString
  endDate   TimestamptzString

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int

  client   Client? @relation(fields: [clientId], references: [id])
  clientId Int?

  venue   Venue? @relation(fields: [venueId], references: [id])
  venueId Int?

  createdBy   User @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdById Int

  departments          Department[]
  crewAssignments      CrewAssignment[]
  equipmentAssignments EquipmentAssignment[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Department {
  id        Int            @id @default(autoincrement())
  name      String
  type      DepartmentType
  notes     String?

  event   Event @relation(fields: [eventId], references: [id])
  eventId Int

  crewAssignments      CrewAssignment[]
  equipmentAssignments EquipmentAssignment[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model CrewMember {
  id Int @id @default(autoincrement())

  name        String
  email       String?
  phone       String?
  designation String?
  crewType    CrewType   @default(FREELANCER)
  status      CrewStatus @default(ACTIVE)
  skills      String?
  notes       String?

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int

  assignments CrewAssignment[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model CrewAssignment {
  id Int @id @default(autoincrement())

  role             String?
  assignmentStatus AssignmentStatus @default(PLANNED)

  callTime    TimestamptzString?
  releaseTime TimestamptzString?

  rate     Decimal?
  rateUnit String?

  notes String?

  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id])
  crewMemberId Int

  event   Event @relation(fields: [eventId], references: [id])
  eventId Int

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId Int?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model EquipmentCategory {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique

  description String?

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int

  equipment Equipment[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Equipment {
  id Int @id @default(autoincrement())

  name         String
  description  String?
  model        String?
  manufacturer String?

  serialNumber String?
  assetNumber  String?

  quantity Int @default(1)

  status    EquipmentStatus    @default(AVAILABLE)
  condition EquipmentCondition @default(GOOD)
  ownership EquipmentOwnership @default(OWNED)

  purchaseDate TimestamptzString?
  purchaseCost Decimal?

  notes String?

  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int

  category   EquipmentCategory @relation(fields: [categoryId], references: [id])
  categoryId Int

  assignments EquipmentAssignment[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model EquipmentAssignment {
  id Int @id @default(autoincrement())

  quantity Int @default(1)

  status AssignmentStatus @default(PLANNED)

  allocatedAt TimestamptzString?
  returnedAt  TimestamptzString?

  notes String?

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId Int

  event   Event @relation(fields: [eventId], references: [id])
  eventId Int

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId Int?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
